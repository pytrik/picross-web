{
  "name": "picross-web",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-color picross (nonogram) puzzles in a single self-contained HTML file",
  "license": "MIT",
  "author": "Pytrik Elzinga",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:debug": "node scripts/build.mjs --debug",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.0"
  }
}
